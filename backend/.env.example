# Copy this file to backend/.env and adjust values for your environment.

# Secret used to sign auth tokens. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-secret-string

# SQLAlchemy database URL. SQLite is the default and needs no external service.
DATABASE_URL=sqlite:///./classroom.db

# Directory where uploaded classroom documents are stored (relative to backend/).
UPLOAD_DIR=./storage/uploads

# Auth token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Maximum allowed upload size in megabytes.
MAX_UPLOAD_SIZE_MB=25

# Comma-separated whitelist of allowed file extensions for uploads.
ALLOWED_EXTENSIONS=pdf,txt,md,doc,docx,xls,xlsx,ppt,pptx,png,jpg,jpeg,gif,csv,zip

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
